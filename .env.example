# .env.example — Copie para .env.local e preencha com seus valores

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── JWT Secret ───────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_FORTE_E_ALEATORIA"

# ─── Domínio(s) de e-mail permitido(s) ─────────────────────────────────────────
# Um ou mais domínios separados por vírgula (sem espaços, sem "@"). Todo
# cadastro/criação de conta (colaborador, gestor, Patrimônio, administrador)
# só aceita e-mail terminado exatamente num destes domínios.
# FAIL-CLOSED: se esta variável não existir, estiver vazia ou não sobrar
# nenhum domínio válido após normalização, NENHUM e-mail é aceito — nunca
# "libera geral" por omissão de configuração. Nunca use um domínio real da
# sua empresa neste arquivo de exemplo.
ALLOWED_EMAIL_DOMAINS="example.com"

# ─── E-mail (Etapa D.1 — infraestrutura; nenhuma rota dispara envio ainda) ─────
# Base oficial para links usados em e-mails.
APP_URL="http://localhost:3000"

# Provedor de e-mail. Único suportado nesta fase: "resend".
EMAIL_PROVIDER="resend"
# Chave de API do provedor. NUNCA use uma chave real neste arquivo.
EMAIL_API_KEY="SUBSTITUA_PELA_CHAVE_DO_PROVEDOR"
EMAIL_FROM_NAME="Fluxo Patrimonial"
EMAIL_FROM_ADDRESS="noreply@exemplo.com"
# Opcional — se vazio, o e-mail é enviado sem cabeçalho Reply-To.
EMAIL_REPLY_TO=""

# Caixa de grupo do Patrimônio: todo e-mail cujo destinatário operacional
# seja "a equipe Patrimônio" (nunca um endereço individual por usuário com
# permissao='patrimonio') é enviado para este único endereço.
EMAIL_PATRIMONIO_RECIPIENT="patrimonio@example.com"

# Modo de homologação: quando "true", TODO envio é redirecionado fisicamente
# para EMAIL_TEST_RECIPIENT, preservando o destinatário original apenas para
# rastreabilidade. Nunca deixe "false" fora de produção. Aceita SOMENTE os
# valores literais "true" ou "false" — qualquer outro valor (ausente,
# "1", "yes" etc.) é tratado como erro de configuração.
EMAIL_TEST_MODE="true"
# Configure obrigatoriamente um endereço autorizado de homologação
# antes de usar EMAIL_TEST_MODE=true.
EMAIL_TEST_RECIPIENT="SUBSTITUA_PELO_EMAIL_DE_TESTE_AUTORIZADO"
